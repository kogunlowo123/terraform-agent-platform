# Copy to terraform.tfvars (or let the TAP workspace inject these as variables).
# NEVER commit qdrant_api_key — supply it via TF_VAR_qdrant_api_key or the
# TAP workspace secret store.

org         = "acme"
environment = "prod"

azure_location = "swedencentral"
aws_region     = "eu-north-1"

owner       = "ai-platform"
cost_center = "CC-2077"
data_class  = "confidential"

allowed_locations      = ["swedencentral", "westeurope"]
vault_allowed_ip_rules = ["203.0.113.0/24"]

kubeconfig_path    = "~/.kube/config"
kubeconfig_context = "acme-prod-aks"

# qdrant_api_key supplied via environment:
#   export TF_VAR_qdrant_api_key="<from secret store>"
